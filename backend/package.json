{
  "name": "foxbase-backend",
  "version": "1.0.0",
  "description": "Backend template for Foxbase: Fastify API, TS Workers, RabbitMQ and Postgres RLS",
  "main": "dist/apis/core/server.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start:api": "node dist/apis/core/server.js",
    "start:worker": "node dist/workers/index.js",
    "start:upload": "node dist/apis/upload/server.js",
    "dev:api": "ts-node-dev --respawn --transpile-only src/apis/core/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/workers/index.ts",
    "dev:upload": "ts-node-dev --respawn --transpile-only src/apis/upload/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "ts-node src/scripts/migrate.ts",
    "db:reset": "node -e \"const postgres = require('postgres'); const sql = postgres('postgres://postgres:foxbase_secure_pwd@localhost:5432/postgres?sslmode=disable'); async function run() { await sql.unsafe('TRUNCATE TABLE auth.users CASCADE; TRUNCATE TABLE public.profiles CASCADE;'); console.log('✅ Banco de dados limpo com sucesso!'); process.exit(0); } run();\"",
    "bootstrap": "ts-node src/scripts/bootstrap.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/multipart": "7.7.3",
    "@fastify/websocket": "^8.2.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "amqplib": "^0.10.3",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.26.2",
    "fastify-type-provider-zod": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^20.11.30",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "rimraf": "^5.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3"
  }
}
