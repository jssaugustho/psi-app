# ==============================================================================
# 🚀 PSI App - Production Environment Variables (.env.production)
# Arquivo de modelo para produção. Copie para `backend/.env` na VPS e preencha.
# NOTA: Credenciais S3/R2 e Resend NÃO ficam neste arquivo, pois são configuradas
# dinamicamente no painel Superadmin e salvas na tabela `public.platform_settings`.
# ==============================================================================

# 🔑 Segredos e Autenticação (Compartilhado entre GoTrue, PostgREST e API Core)
# OBRIGATÓRIO: Mínimo 32 caracteres aleatórios de alta entropia em produção
JWT_SECRET=substitua_por_um_jwt_secret_ultra_seguro_de_pelo_menos_32_caracteres

# 🛡️ Chave Secreta dos Serviços Internos (UUIDv4 único)
SERVICE_SECRET_KEY=substitua-por-um-uuidv4-unico-para-servicos-internos

# 🐘 Banco de Dados PostgreSQL (Conectado via rede interna do Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=substitua_por_senha_forte_do_postgres_prod
POSTGRES_DB=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:substitua_por_senha_forte_do_postgres_prod@postgres:5432/postgres?sslmode=disable

# 🐇 RabbitMQ Mensageria & Filas Quorum
RABBITMQ_DEFAULT_USER=psi_admin
RABBITMQ_DEFAULT_PASS=substitua_por_senha_forte_do_rabbitmq_prod
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://psi_admin:substitua_por_senha_forte_do_rabbitmq_prod@rabbitmq:5672

# ⚡ Fastify API Core & Gateway Nginx
PORT=5000
NODE_ENV=production
NGINX_PORT=8000

# 🔑 Supabase Auth (GoTrue)
GOTRUE_SITE_URL=https://app.seudominio.com.br
GOTRUE_URI_ALLOW_LIST=https://app.seudominio.com.br/*
GOTRUE_API_EXTERNAL_URL=https://api.seudominio.com.br/auth/v1
GOTRUE_URL=http://gotrue:9999
GOTRUE_MAILER_AUTOCONFIRM=false

# ☁️ Cloudflare Tunnel Token (Opcional - caso utilize o container tunnel para expor o Nginx)
TUNNEL_TOKEN=seu_token_do_cloudflare_tunnel
