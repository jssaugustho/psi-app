# 🔑 Segredos e Assinatura JWT (Compartilhado entre GoTrue, PostgREST e API)
# Deve possuir no mínimo 32 caracteres para compatibilidade com PostgREST v12+
JWT_SECRET=foxbase_super_secret_jwt_token_for_local_dev_32_chars

# 🐘 Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=foxbase_secure_pwd
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=3

# 🐇 RabbitMQ Mensageria
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ⚡ Configurações da API Fastify
PORT=5000

# 🔑 Configurações do GoTrue (Autenticação)
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_URL=http://gotrue:9999

# 🛡️ Chave Secreta dos Serviços (UUID)
SERVICE_SECRET_KEY=c3d9a7e1-8f2b-4d5c-9e1a-6f4b3a2c1d0e

# ☁️ Cloudflare Tunnel Token
TUNNEL_TOKEN=

