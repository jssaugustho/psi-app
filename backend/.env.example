# ==============================================================================
# 🛠️ PSI App - Local Development Environment Variables (.env)
# ==============================================================================

# 🔑 Segredos e Autenticação (Compartilhado entre GoTrue, PostgREST e API Core)
# OBRIGATÓRIO: Mínimo 32 caracteres seguros para assinatura de tokens JWT
JWT_SECRET=psi_super_secret_jwt_token_for_local_dev_32_chars

# 🛡️ Chave Secreta dos Serviços (UUIDv4 para comunicação de APIs internas)
SERVICE_SECRET_KEY=c3d9a7e1-8f2b-4d5c-9e1a-6f4b3a2c1d0e

# 🐘 Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=psi_secure_pwd
POSTGRES_DB=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:psi_secure_pwd@localhost:5432/postgres?sslmode=disable

# 🐇 RabbitMQ Mensageria & Filas Quorum
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ⚡ Fastify API Core & Gateway Nginx
PORT=5000
NODE_ENV=development
NGINX_PORT=8000

# 🔑 Supabase Auth (GoTrue)
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_URI_ALLOW_LIST=http://localhost:3000/*
GOTRUE_API_EXTERNAL_URL=http://localhost:8000/auth/v1
GOTRUE_URL=http://gotrue:9999
GOTRUE_MAILER_AUTOCONFIRM=true

# ☁️ Cloudflare Tunnel (Opcional no Dev Local)
TUNNEL_TOKEN=
