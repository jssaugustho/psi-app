{
  "name": "psi-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "turbo run dev --filter=@psi/web",
    "dev:admin": "turbo run dev --filter=@psi/admin",
    "build:web": "turbo run build --filter=@psi/web",
    "build:admin": "turbo run build --filter=@psi/admin",
    "build": "turbo run build"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5"
  }
}
